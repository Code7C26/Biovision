<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower.
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Contiene credenciales de reMarkets: no debe salir del dispositivo -->
    <exclude domain="sharedpref" path="granex_weather_notification_prefs.xml"/>
    <!-- Sesión de Supabase (tokens cifrados con una clave del Keystore que no se puede restaurar) -->
    <exclude domain="sharedpref" path="granex_sesion.xml"/>
    <!-- Datos de la cuenta (lotes, suelo, rinde): viven en la cuenta y solo se bajan con sesión -->
    <exclude domain="sharedpref" path="granex_sync.xml"/>
    <exclude domain="database" path="granex_agtech_db"/>
    <exclude domain="database" path="granex_agtech_db-shm"/>
    <exclude domain="database" path="granex_agtech_db-wal"/>
    <exclude domain="file" path="agronomia/"/>
        <exclude domain="file" path="agenda/"/>
</full-backup-content>
