<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for Android 12+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Credenciales de reMarkets, la sesión y los datos de la cuenta (lotes, suelo, rinde) no salen
         del dispositivo: los datos viven en la cuenta y solo se bajan con sesión -->
    <cloud-backup>
        <exclude domain="sharedpref" path="granex_weather_notification_prefs.xml"/>
        <exclude domain="sharedpref" path="granex_sesion.xml"/>
        <exclude domain="sharedpref" path="granex_sync.xml"/>
        <exclude domain="database" path="granex_agtech_db"/>
        <exclude domain="database" path="granex_agtech_db-shm"/>
        <exclude domain="database" path="granex_agtech_db-wal"/>
        <exclude domain="file" path="agronomia/"/>
        <exclude domain="file" path="agenda/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="granex_weather_notification_prefs.xml"/>
        <exclude domain="sharedpref" path="granex_sesion.xml"/>
        <exclude domain="sharedpref" path="granex_sync.xml"/>
        <exclude domain="database" path="granex_agtech_db"/>
        <exclude domain="database" path="granex_agtech_db-shm"/>
        <exclude domain="database" path="granex_agtech_db-wal"/>
        <exclude domain="file" path="agronomia/"/>
        <exclude domain="file" path="agenda/"/>
    </device-transfer>
</data-extraction-rules>
